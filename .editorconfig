root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.xml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.json]
indent_size = 2

[*.{ps1,bat,cmd}]
end_of_line = crlf
indent_size = 4

