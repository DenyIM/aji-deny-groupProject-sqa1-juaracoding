<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="HADIR Magang Enterprise Master Suite" parallel="classes" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="com.juaracoding.magang.listeners.TestListener" />
    </listeners>

    <parameter name="browser" value="chrome" />
    <parameter name="headless" value="true" />

    <test name="Tester Deny - Admin HRD Scope">
        <classes>
            <class name="com.juaracoding.magang.api.admin.AdminSmokeApiTest" />
            <class name="com.juaracoding.magang.tests.admin.AdminSmokeUiTest" />
        </classes>
    </test>

    <test name="Tester Aji - User Magang Scope">
        <classes>
            <class name="com.juaracoding.magang.api.user.UserSmokeApiTest" />
            <class name="com.juaracoding.magang.tests.user.UserSmokeUiTest" />
        </classes>
    </test>

</suite>

