<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="HADIR Magang - Tester Aji (User Magang Suite)" parallel="classes" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="com.juaracoding.magang.listeners.TestListener" />
    </listeners>

    <parameter name="browser" value="chrome" />
    <parameter name="headless" value="true" />

    <test name="User Magang - API &amp; Web UI Tests">
        <classes>
            <class name="com.juaracoding.magang.api.user.UserSmokeApiTest" />
            <class name="com.juaracoding.magang.tests.user.UserSmokeUiTest" />
        </classes>
    </test>

</suite>

